# Environment variables required for local development and production.
# Copy this file to .env or .env.local and fill in the values.

# Supabase Configurations
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI & LLM APIs (Gemini Free Tier)
GEMINI_API_KEY=your-gemini-api-key

# Application APIs
NEXT_PUBLIC_API_SECRET_TOKEN=your-random-api-token
